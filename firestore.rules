rules_version = '2';
// Each signed-in user may read and write exactly one document: their own.
// Nobody can list the collection or touch anyone else's row.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trainerState/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && (request.method == 'delete' || request.resource.data.state is string)
                         && (request.method == 'delete' || request.resource.data.state.size() < 900000);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
