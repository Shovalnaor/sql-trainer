// ============================================================================
//  שתי דרכים להשתמש בקובץ הזה. בחר אחת.
//
//  א. פרויקט Firebase חדש ייעודי למאמן:
//     העתק את כל הקובץ הזה אל Firestore > Rules > Publish.
//
//  ב. פרויקט Firebase קיים שכבר משרת אפליקציה אחרת (וזה המצב אם נגמרה
//     מכסת הפרויקטים):
//     *** אל תחליף את הכללים הקיימים! זה ישבור את האפליקציה האחרת. ***
//     הוסף רק את הבלוק המסומן למטה כ-"ADD THIS BLOCK", בתוך
//     match /databases/{database}/documents { ... } הקיים, לצד שאר הכללים,
//     ולפני כל כלל גורף שחוסם את מה שלא מורשה.
//
//  האוסף נקרא trainerState ואף אפליקציה אחרת לא תיגע בו, כך שאין התנגשות.
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- ADD THIS BLOCK ----------------
    // כל משתמש מחובר קורא וכותב מסמך אחד בלבד: שלו.
    // אין הרשאת list, ולכן אי אפשר לסרוק את האוסף ולגלות מי עוד רשום.
    match /trainerState/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId
                         && (request.method == 'delete' || request.resource.data.state is string)
                         && (request.method == 'delete' || request.resource.data.state.size() < 900000);
    }
    // -------------- END OF BLOCK TO ADD --------------

    // הכלל הגורף הזה שייך לגרסה א' בלבד.
    // בפרויקט קיים אל תעתיק אותו: הכללים הקיימים שלך כבר מכסים את השאר.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
